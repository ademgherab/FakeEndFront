{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "MockApi": {
    "Limits": {
      "MaxEndpointsPerProject": 10,
      "MaxSampleBytes": 102400,
      "MaxRequestBodyBytes": 262144,
      "MaxMockRequestBodyBytes": 65536,
      "MaxPathLength": 200,
      "MaxDelayMs": 10000,
      "MaxListSize": 1000,
      "MaxPaginationTotalItems": 10000,
      "MaxPaginationLimit": 100,
      "MaxErrorStatusCodes": 10,
      "DailyRequestsPerProject": 5000,
      "MaxLogEntriesPerProject": 1000,
      "MaxGeneratedValuesPerResponse": 100000,
      "MaxSchemaNodes": 2000,
      "MaxSchemaDepth": 10,
      "MaxFieldNameLength": 100,
      "MaxFieldsPerObject": 100,
      "MaxEnumValues": 50
    },
    "Projects": {
      "LifetimeDays": 7,
      "ExpiryGraceDays": 3,
      "SlugLength": 10
    },
    "RateLimits": {
      "CreateProjectPerHour": 10,
      "InferPreviewPerMinute": 30,
      "ManagementWritePerMinute": 60,
      "ManagementReadPerMinute": 120,
      "RuntimeSlugPerMinute": 120,
      "RuntimeIpPerMinute": 600
    },
    "Cors": {
      "ManagementOrigins": [
        "http://localhost:3000"
      ]
    },
    "Runtime": {
      "MockBaseUrl": "https://api.example.com/m"
    },
    "Images": {
      "ImageUrlTemplate": "https://picsum.photos/seed/{seed}/200/200",
      "AvatarUrlTemplate": "https://i.pravatar.cc/150?u={seed}"
    },
    "Errors": {
      "BaseUrl": "https://example.com"
    },
    "Health": {
      "TimeoutSeconds": 2
    },
    "Workers": {
      "LogQueueCapacity": 10000,
      "LogBatchSize": 200,
      "LogFlushIntervalMs": 2000,
      "UsageFlushIntervalMs": 5000,
      "CleanupIntervalSeconds": 60,
      "PurgeIntervalSeconds": 3600
    }
  }
}
