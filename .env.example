# Copy this file to .env.local and fill in the values for your environment.
#
# Public management API origin. No trailing slash and no /api/v1 suffix:
# the client appends /api/v1 itself. NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time and must never contain secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# Public origin of this frontend. Used for canonical links and OG metadata.
# No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional. Origin that serves the mock runtime. When omitted, the app uses
# `mockBaseUrl` from GET /api/v1/meta at runtime.
NEXT_PUBLIC_MOCK_BASE_URL=

# Optional. Bump this when the frontend depends on a newer /meta shape;
# it is part of the meta cache key. Defaults to 0.1.0.
NEXT_PUBLIC_APP_VERSION=

# Optional. Set to true to start the MSW contract mocks in the browser, so the
# app runs without a backend (used by `pnpm dev:mock` and the E2E suite).
NEXT_PUBLIC_ENABLE_MOCKS=

# Optional. Set to true only for `pnpm dev:mock` and E2E runs. The app then
# starts the MSW service worker and serves the contract mocks entirely in the
# browser. Never enable this in production.
NEXT_PUBLIC_ENABLE_MOCKS=false
